TMDB_API_KEY=
OPENROUTER_API_KEY=
# Optional: read-only cache behind the Leaving Soon rail (rail is hidden when unset)
SUPABASE_URL=
SUPABASE_ANON_KEY=
ATLAS_MODEL=openai/gpt-5-nano
# Account sign-in: the same Supabase project as the iOS app (public values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# WatchGuide Pro: Paddle takes the payment, RevenueCat holds the entitlement
# Paddle > Developer tools > Authentication > Client-side tokens (test_... for sandbox, live_... for production)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Paddle price IDs (pri_...), the same prices imported into RevenueCat
NEXT_PUBLIC_PADDLE_PRICE_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY=
# RevenueCat public API key of the Paddle app (server-side only)
REVENUECAT_PADDLE_API_KEY=
# RapidAPI JustWatch (server-side only; host is optional)
RAPIDAPI_KEY=
RAPIDAPI_JUSTWATCH_HOST=justwatch9.p.rapidapi.com
# Reminders (web push). Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Upstash Redis (Vercel Marketplace sets these when you connect the database)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel Cron sends this as a Bearer token to /api/cron/reminders (any long random string)
CRON_SECRET=
