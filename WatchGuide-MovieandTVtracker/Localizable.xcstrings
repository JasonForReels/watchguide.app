    "Create a profile to personalize your experience. Your profile syncs across all your devices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ ملفًا لتخصيص تجربتك. تتم مزامنة ملفك عبر جميع أجهزتك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un perfil para personalizar tu experiencia. Tu perfil se sincroniza en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un profil pour personnaliser votre expérience. Votre profil se synchronise sur tous vos appareils."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने अनुभव को निजी बनाने के लिए प्रोफ़ाइल बनाएँ। आपकी प्रोफ़ाइल आपके सभी डिवाइस पर सिंक होती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロフィールを作成して体験をカスタマイズしましょう。プロフィールはすべてのデバイスで同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필을 만들어 나에게 맞는 경험을 즐기세요. 프로필은 모든 기기에서 동기화됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создайте профиль, чтобы персонализировать приложение. Профиль синхронизируется на всех ваших устройствах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
