        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n’est pas installé. Téléchargez-le ou passez à WatchGuide Pro pour des liens directs instantanés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ इंस्टॉल नहीं है। इसे डाउनलोड करें या तुरंत डीप लिंक के लिए WatchGuide Pro में अपग्रेड करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がインストールされていません。入手するか、WatchGuide Proにアップグレードしてディープリンクを利用しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱이 설치되어 있지 않습니다. 앱을 받거나 WatchGuide Pro로 업그레이드하여 바로 연결되는 딥 링크를 사용하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не установлено. Установите приложение или перейдите на WatchGuide Pro для мгновенных прямых ссылок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
