    "Tonight shows you one pick at a time. Swipe until something clicks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعرض «الليلة» اختيارًا واحدًا في كل مرة. اسحب حتى يعجبك شيء."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta noche te muestra una propuesta cada vez. Desliza hasta que algo te convenza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce soir vous propose un titre à la fois. Balayez jusqu’au coup de cœur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज रात एक बार में एक सुझाव दिखाता है। तब तक स्वाइप करें जब तक कुछ पसंद न आ जाए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今夜」は1作品ずつ提案します。ピンとくるまでスワイプしよう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 밤은 한 번에 한 작품씩 보여 줍니다. 마음에 드는 작품이 나올 때까지 넘겨 보세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Сегодня» показывает по одному варианту. Листайте, пока что-нибудь не зацепит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“今晚”每次只推荐一部。轻扫直到找到心动的那一部。"
          }
        }
      }
    },
