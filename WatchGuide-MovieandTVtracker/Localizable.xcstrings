    "Ask Watch Guide ${question}" : {},
    "Ask a question about movies and TV. Answered privately on-device when supported." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطرح سؤالًا عن الأفلام والمسلسلات. تتم الإجابة بخصوصية على الجهاز عند الدعم."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz una pregunta sobre películas y series. Se responde de forma privada en el dispositivo cuando es compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez une question sur les films et séries. Réponse privée sur l’appareil lorsque c’est possible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िल्मों और टीवी के बारे में सवाल पूछें। समर्थित होने पर जवाब डिवाइस पर निजी रूप से मिलता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画やTVについて質問できます。対応デバイスではデバイス上で非公開で回答します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영화와 TV에 대해 질문하세요. 지원되는 경우 기기에서 비공개로 답변합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте вопрос о кино и сериалах. Ответ формируется конфиденциально на устройстве, если это поддерживается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提出关于电影和剧集的问题。在支持的设备上会在本机私密作答。"
          }
        }
      }
    },
    "Ask anything, plan every cinema trip, and see your watching like never before." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسأل عن أي شيء، وخطِّط لكل رحلة سينما، وشاهد نشاطك كما لم تره من قبل."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta lo que quieras, planea cada salida al cine y descubre tus hábitos como nunca antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez n’importe quoi, planifiez chaque sortie cinéma et découvrez vos visionnages comme jamais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ भी पूछें, हर सिनेमा ट्रिप प्लान करें और अपनी देखी हुई चीज़ें पहले कभी न देखे अंदाज़ में देखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何でも聞いて、映画館に行く計画を立て、これまでにない形で視聴記録を楽しもう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무엇이든 묻고, 모든 영화관 나들이를 계획하고, 지금껏 본 적 없는 방식으로 시청 기록을 확인하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрашивайте что угодно, планируйте каждый поход в кино и смотрите на свои просмотры по-новому."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随心提问，规划每次观影行程，以前所未有的方式回顾你的观影。"
          }
        }
      }
    },
