    "%@ isn't installed. Get it or upgrade to WatchGuide Pro for instant deep links." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطبيق %@ غير مثبَّت. نزِّله أو رقِّ إلى WatchGuide Pro للحصول على روابط مباشرة فورية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no está instalada. Descárgala o hazte WatchGuide Pro para enlaces directos al instante."
