    "Watch the events in the order they happened in-universe." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد الأحداث بالترتيب الذي وقعت به داخل العالم القصصي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira los acontecimientos en el orden en que ocurrieron dentro del universo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez les événements dans l’ordre où ils se sont produits dans l’univers."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "घटनाओं को उसी क्रम में देखें जिसमें वे कहानी में हुईं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作中で起きた順に出来事を観よう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작품 속에서 일어난 순서대로 사건을 감상하세요."
