    "You can always add or remove profiles later from Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك دائمًا إضافة الملفات أو إزالتها لاحقًا من الإعدادات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre puedes añadir o quitar perfiles más tarde en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez toujours ajouter ou supprimer des profils plus tard dans les Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
