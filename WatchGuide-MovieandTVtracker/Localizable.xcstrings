    "Kids profile is active. Content is restricted to ages 6-12. Switch to a different profile to access all content." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف الأطفال مفعّل. المحتوى مقيَّد بأعمار 6-12. بدِّل إلى ملف آخر للوصول إلى كل المحتوى."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil infantil está activo. El contenido está limitado a edades de 6 a 12 años. Cambia a otro perfil para acceder a todo el contenido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil Enfants est actif. Le contenu est limité aux 6-12 ans. Changez de profil pour accéder à tout le contenu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किड्स प्रोफ़ाइल सक्रिय है। सामग्री 6-12 वर्ष तक सीमित है। पूरी सामग्री के लिए दूसरी प्रोफ़ाइल पर जाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キッズプロフィールが有効です。コンテンツは6〜12歳向けに制限されています。すべてのコンテンツを見るには別のプロフィールに切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키즈 프로필이 켜져 있습니다. 콘텐츠가 6~12세로 제한됩니다. 모든 콘텐츠를 보려면 다른 프로필로 전환하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Детский профиль включён. Контент ограничен возрастом 6–12 лет. Переключитесь на другой профиль для доступа ко всему контенту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儿童资料已开启，内容仅限 6-12 岁。切换到其他资料以访问全部内容。"
          }
        }
      }
    },
