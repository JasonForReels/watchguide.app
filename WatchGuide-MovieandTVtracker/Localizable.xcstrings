    "Select the services you subscribe to. Only content from your services will appear." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر الخدمات التي تشترك فيها. سيظهر المحتوى من خدماتك فقط."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona los servicios a los que estás suscrito. Solo aparecerá contenido de tus servicios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez les services auxquels vous êtes abonné. Seul le contenu de vos services apparaîtra."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन सेवाओं की सदस्यता आपके पास है, उन्हें चुनें। केवल आपकी सेवाओं की सामग्री दिखेगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "契約中のサービスを選んでください。そのサービスのコンテンツだけが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독 중인 서비스를 선택하세요. 선택한 서비스의 콘텐츠만 표시됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите сервисы, на которые вы подписаны. Будет показан только их контент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择你订阅的服务。只会显示这些服务上的内容。"
          }
        }
      }
    },
    "Select the streaming services you subscribe to\nand we'll show you what's available to watch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
