    "Extra time for parking, buying popcorn, finding your seat, and settling in before the movie starts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقت إضافي لركن السيارة وشراء الفشار والعثور على مقعدك والاستقرار قبل بدء الفيلم."
          }
        },
        "es" : {
          "stringUnit" : {
