    "Follow these steps to enable cloud syncing for your watchlist, watched items, and liked items." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتبع هذه الخطوات لتفعيل المزامنة السحابية لقائمة المشاهدة والأعمال المشاهدة والإعجابات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue estos pasos para activar la sincronización en la nube de tu lista, lo que has visto y tus me gusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez ces étapes pour activer la synchronisation cloud de votre liste, de vos titres vus et de vos j’aime."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी वॉचलिस्ट, देखे गए और पसंद किए गए आइटम का क्लाउड सिंक चालू करने के लिए ये कदम अपनाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウォッチリスト、視聴済み、いいねのクラウド同期を有効にするには、次の手順に従ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고 싶은 목록, 시청한 작품, 좋아요 항목의 클라우드 동기화를 켜려면 다음 단계를 따르세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выполните эти шаги, чтобы включить облачную синхронизацию списка «Буду смотреть», просмотренного и понравившегося."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按以下步骤为待看清单、已看和喜欢的内容启用云同步。"
          }
        }
      }
    },
