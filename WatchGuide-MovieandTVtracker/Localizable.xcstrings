    "Your date of birth determines what content is available on this profile. This syncs with your account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد تاريخ ميلادك المحتوى المتاح في هذا الملف. تتم مزامنته مع حسابك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu fecha de nacimiento determina qué contenido está disponible en este perfil. Se sincroniza con tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre date de naissance détermine le contenu disponible sur ce profil. Elle se synchronise avec votre compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी जन्मतिथि तय करती है कि इस प्रोफ़ाइल पर कौन-सी सामग्री उपलब्ध है। यह आपके खाते से सिंक होती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生年月日によって、このプロフィールで利用できるコンテンツが決まります。アカウントと同期されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생년월일에 따라 이 프로필에서 볼 수 있는 콘텐츠가 결정됩니다. 계정과 동기화됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дата рождения определяет, какой контент доступен в этом профиле. Она синхронизируется с учётной записью."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的出生日期决定此资料可以看到的内容。它会与你的账户同步。"
          }
        }
      }
    },
    "Your date of birth determines what content you'll see. This is stored securely with your account." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحدد تاريخ ميلادك المحتوى الذي ستراه. يُخزَّن بأمان مع حسابك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu fecha de nacimiento determina qué contenido verás. Se guarda de forma segura en tu cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre date de naissance détermine le contenu que vous verrez. Elle est stockée de manière sécurisée avec votre compte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी जन्मतिथि तय करती है कि आपको कौन-सी सामग्री दिखेगी। यह आपके खाते के साथ सुरक्षित रूप से रखी जाती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生年月日によって、表示されるコンテンツが決まります。アカウントに安全に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생년월일에 따라 볼 수 있는 콘텐츠가 결정됩니다. 계정에 안전하게 저장됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дата рождения определяет, какой контент вы увидите. Она надёжно хранится в вашей учётной записи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的出生日期决定你可以看到的内容。它会安全地存储在你的账户中。"
          }
        }
      }
    },
