    "This will permanently remove this profile. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي ذلك إلى إزالة هذا الملف نهائيًا. لا يمكن التراجع عن ذلك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará este perfil para siempre. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce profil sera définitivement supprimé. Action irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे यह प्रोफ़ाइल हमेशा के लिए हट जाएगी। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロフィールは完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필이 영구적으로 제거됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Профиль будет удалён навсегда. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久移除此资料，且无法撤销。"
          }
        }
      }
    },
    "This will remove all your lists, watched history, and preferences. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي ذلك إلى إزالة كل قوائمك وسجل مشاهدتك وتفضيلاتك. لا يمكن التراجع عن ذلك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará todas tus listas, tu historial y tus preferencias. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera toutes vos listes, votre historique et vos préférences. Action irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे आपकी सभी सूचियाँ, देखने की हिस्ट्री और प्राथमिकताएँ हट जाएँगी। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのリスト、視聴履歴、設定が削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 목록, 시청 기록, 환경설정이 제거됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все ваши списки, история просмотров и настройки будут удалены. Это действие нельзя отменить."
          }
        },
        "zh-Hans" : {
