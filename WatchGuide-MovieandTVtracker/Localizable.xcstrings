    "WatchHour" : {},
    "WatchHour tracks your viewing, compares you with the community, shows achievements, and brings trending entertainment to your fingertips." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتتبّع WatchHour مشاهداتك، ويقارنك بالمجتمع، ويعرض إنجازاتك، ويضع الترفيه الرائج بين يديك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchHour registra lo que ves, te compara con la comunidad, muestra logros y te acerca lo más popular del entretenimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchHour suit vos visionnages, vous compare à la communauté, affiche vos succès et met les tendances du divertissement à portée de main."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchHour आपकी देखी गई चीज़ें ट्रैक करता है, कम्युनिटी से तुलना करता है, उपलब्धियाँ दिखाता है और ट्रेंडिंग मनोरंजन आपकी उँगलियों पर लाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchHourは視聴を記録し、コミュニティと比較し、実績を表示し、話題のエンタメをすぐ手元に届けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchHour는 시청 기록을 추적하고, 커뮤니티와 비교하고, 업적을 보여 주고, 인기 엔터테인먼트를 손끝으로 가져다줍니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchHour отслеживает ваши просмотры, сравнивает вас с сообществом, показывает достижения и держит тренды развлечений под рукой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchHour 记录你的观看，与社区比较，展示成就，并让热门娱乐触手可及。"
          }
        }
      }
    },
