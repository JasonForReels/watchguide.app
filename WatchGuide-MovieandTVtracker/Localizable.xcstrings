    "Your smart lists are already up to date. Delete existing ones if you'd like a fresh set." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قوائمك الذكية محدّثة بالفعل. احذف الموجودة إذا أردت مجموعة جديدة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus listas inteligentes ya están al día. Elimina las que tengas si quieres un conjunto nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos listes intelligentes sont déjà à jour. Supprimez-les si vous voulez en créer de nouvelles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी स्मार्ट सूचियाँ पहले से अप-टू-डेट हैं। नया सेट चाहिए तो मौजूदा सूचियाँ हटा दें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スマートリストはすでに最新です。新しく作りたい場合は既存のものを削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스마트 목록이 이미 최신 상태입니다. 새로 만들고 싶다면 기존 목록을 삭제하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши умные списки уже актуальны. Удалите существующие, если хотите получить новый набор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的智能片单已是最新。如需全新的一组，请先删除现有片单。"
          }
        }
      }
    },
    "Your taste,\nsupercharged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
