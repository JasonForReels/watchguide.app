          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion par e-mail nécessite Supabase. Liez Supabase dans les Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
