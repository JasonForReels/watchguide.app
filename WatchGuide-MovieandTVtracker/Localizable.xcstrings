    "Tap + to enter a Stremio-compatible endpoint URL and enable direct trailer playback." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط + لإدخال رابط نقطة نهاية متوافقة مع Stremio وتفعيل تشغيل الإعلانات مباشرة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca + para introducir la URL de un endpoint compatible con Stremio y activar la reproducción directa de tráileres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez + pour saisir l’URL d’un point de terminaison compatible Stremio et activer la lecture directe des bandes-annonces."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stremio-संगत एंडपॉइंट URL डालने और सीधे ट्रेलर चलाने के लिए + पर टैप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "＋をタップしてStremio互換エンドポイントのURLを入力すると、予告編を直接再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+를 탭하고 Stremio 호환 엔드포인트 URL을 입력하면 예고편을 바로 재생할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите +, чтобы ввести URL конечной точки, совместимой со Stremio, и включить прямое воспроизведение трейлеров."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点 + 输入兼容 Stremio 的端点网址，即可直接播放预告片。"
          }
        }
      }
    },
    "Tap Watch or Continue Watching on any title and WatchHour will start tracking here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط «مشاهدة» أو «متابعة المشاهدة» على أي عمل وسيبدأ WatchHour التتبع هنا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Ver o Seguir viendo en cualquier título y WatchHour empezará a registrarlo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Regarder ou Reprendre sur n’importe quel titre et WatchHour commencera le suivi ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी टाइटल पर देखें या देखना जारी रखें पर टैप करें, और WatchHour यहाँ ट्रैक करना शुरू कर देगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作品の「観る」または「視聴を続ける」をタップすると、WatchHourがここで記録を始めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 작품에서나 시청 또는 이어서 보기를 탭하면 WatchHour가 여기서 기록을 시작합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Смотреть» или «Продолжить просмотр» у любого фильма, и WatchHour начнёт вести учёт здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意作品上轻点“观看”或“继续观看”，WatchHour 就会在这里开始记录。"
          }
        }
      }
    },
