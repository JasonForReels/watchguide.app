    "Sign in to sync your watchlist, watched items, and likes across all your devices" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجِّل الدخول لمزامنة قائمة المشاهدة والأعمال المشاهدة والإعجابات عبر جميع أجهزتك"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para sincronizar tu lista, lo que has visto y tus me gusta en todos tus dispositivos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour synchroniser votre liste, vos titres vus et vos j’aime sur tous vos appareils"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी वॉचलिस्ट, देखे गए आइटम और पसंद सभी डिवाइस पर सिंक करने के लिए साइन इन करें"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインして、ウォッチリスト、視聴済み、いいねをすべてのデバイスで同期しましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인하면 보고 싶은 목록, 시청한 작품, 좋아요를 모든 기기에서 동기화할 수 있습니다"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите, чтобы синхронизировать список «Буду смотреть», просмотренное и понравившееся на всех устройствах"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录以在所有设备间同步待看清单、已看和喜欢的内容"
          }
        }
