        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите события в том порядке, в каком они произошли во вселенной."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按故事中发生的顺序观看。"
          }
        }
      }
    },
    "Watch the movies in the order they were released in theaters." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد الأفلام بترتيب صدورها في دور السينما."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira las películas en el orden en que se estrenaron en cines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez les films dans leur ordre de sortie au cinéma."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िल्मों को सिनेमाघरों में रिलीज़ के क्रम में देखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "劇場公開順に映画を観よう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "극장 개봉 순서대로 영화를 감상하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите фильмы в порядке выхода в кино."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按院线上映顺序观看电影。"
          }
        }
      }
    },
    "Watch trailers and uncover legendary facts from your favorite cinematic universes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد الإعلانات واكتشف حقائق أسطورية من عوالمك السينمائية المفضلة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira tráileres y descubre datos legendarios de tus universos cinematográficos favoritos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez des bandes-annonces et découvrez des anecdotes légendaires de vos univers cinématographiques préférés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रेलर देखें और अपने पसंदीदा सिनेमैटिक यूनिवर्स के दिलचस्प तथ्य जानें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予告編を観て、お気に入りのシネマティック・ユニバースの伝説的な豆知識を発見しよう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예고편을 보고 좋아하는 시네마틱 유니버스의 전설적인 상식을 알아보세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите трейлеры и узнавайте легендарные факты о любимых киновселенных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "观看预告片，发掘你最爱的电影宇宙中的传奇冷知识。"
          }
        }
      }
    },
