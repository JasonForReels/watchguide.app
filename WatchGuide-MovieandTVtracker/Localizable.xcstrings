    "Locked to ages 6-12. Only shows kid-friendly content." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقيَّد بأعمار 6-12. يعرض محتوى مناسبًا للأطفال فقط."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limitado a edades de 6 a 12 años. Solo muestra contenido apto para niños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limité aux 6-12 ans. N’affiche que du contenu adapté aux enfants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6-12 वर्ष तक सीमित। केवल बच्चों के अनुकूल सामग्री दिखाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6〜12歳に制限。子ども向けコンテンツのみ表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6~12세로 제한됩니다. 어린이 친화적인 콘텐츠만 표시합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только 6–12 лет. Показывается только детский контент."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅限 6-12 岁，只显示适合儿童的内容。"
          }
        }
