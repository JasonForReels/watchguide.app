          }
        }
      }
    },
    "Enable Kids Profile to restrict content to ages 13 and under and hide Atlas. A parent passcode protects the setting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فعِّل ملف الأطفال لتقييد المحتوى لسن 13 عامًا وأقل وإخفاء Atlas. يحمي رمز الوالدين هذا الإعداد."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el perfil infantil para limitar el contenido a menores de 13 años y ocultar Atlas. Un código parental protege este ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le profil Enfants pour limiter le contenu aux 13 ans et moins et masquer Atlas. Un code parental protège ce réglage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामग्री को 13 वर्ष और उससे कम तक सीमित करने और Atlas छिपाने के लिए किड्स प्रोफ़ाइल चालू करें। यह सेटिंग अभिभावक पासकोड से सुरक्षित रहती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キッズプロフィールを有効にすると、コンテンツが13歳以下向けに制限され、Atlasが非表示になります。この設定は保護者パスコードで保護されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키즈 프로필을 켜면 콘텐츠가 13세 이하로 제한되고 Atlas가 숨겨집니다. 이 설정은 보호자 암호로 보호됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите детский профиль, чтобы ограничить контент возрастом до 13 лет и скрыть Atlas. Настройка защищена родительским кодом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用儿童资料后，内容将限制为 13 岁及以下，并隐藏 Atlas。此设置受家长密码保护。"
          }
        }
      }
    },
