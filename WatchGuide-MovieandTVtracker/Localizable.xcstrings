    "A Kids profile is locked to ages 6-12 and only shows family-friendly content. It works just like Netflix Kids." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملف الأطفال مقيَّد بأعمار 6-12 ويعرض محتوى عائليًا فقط. يعمل تمامًا مثل Netflix Kids."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un perfil infantil está limitado a edades de 6 a 12 años y solo muestra contenido para toda la familia. Funciona igual que Netflix Kids."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un profil Enfants est limité aux 6-12 ans et n’affiche que du contenu familial. Il fonctionne comme Netflix Kids."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किड्स प्रोफ़ाइल 6-12 वर्ष तक सीमित है और केवल परिवार के अनुकूल सामग्री दिखाती है। यह बिल्कुल Netflix Kids की तरह काम करती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キッズプロフィールは6〜12歳向けに制限され、ファミリー向けのコンテンツだけを表示します。Netflixキッズと同じ仕組みです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키즈 프로필은 6~12세로 제한되며 가족 친화적인 콘텐츠만 표시합니다. Netflix 키즈와 같은 방식입니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Детский профиль ограничен возрастом 6–12 лет и показывает только семейный контент. Работает так же, как Netflix Kids."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儿童资料仅限 6-12 岁，只显示适合全家观看的内容，与 Netflix 儿童版相同。"
          }
        }
      }
    },
