    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Watch Guide الكاميرا لمسح الملصقات والتعرف على الأعمال في التطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Watch Guide uses the camera to scan posters and identify titles in the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide usa la cámara para escanear pósteres e identificar títulos en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide utilise l’appareil photo pour scanner des affiches et identifier les titres dans l’app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide पोस्टर स्कैन करने और ऐप में टाइटल पहचानने के लिए कैमरे का इस्तेमाल करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guideはカメラを使ってポスターをスキャンし、アプリ内で作品を特定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide는 카메라를 사용해 포스터를 스캔하고 앱에서 작품을 식별합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide использует камеру, чтобы сканировать постеры и находить фильмы в приложении."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide 使用相机扫描海报并在应用中识别作品。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Watch Guide موقعك لعرض دور السينما القريبة والمسافات بالكيلومترات."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Watch Guide uses your location to show nearby cinemas and distances in kilometers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide usa tu ubicación para mostrar los cines cercanos y la distancia en kilómetros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide utilise votre position pour afficher les cinémas à proximité et leurs distances en kilomètres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide आस-पास के सिनेमाघर और उनकी दूरी किलोमीटर में दिखाने के लिए आपकी लोकेशन का इस्तेमाल करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guideは位置情報を使って近くの映画館と距離（km）を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide는 위치 정보를 사용해 주변 영화관과 거리(km)를 표시합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide использует вашу геопозицию, чтобы показывать ближайшие кинотеатры и расстояние в километрах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide 使用你的位置显示附近影院及其距离（公里）。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم WatchGuide الميكروفون للمحادثات الصوتية في «اسأل Atlas»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "WatchGuide uses your microphone for voice conversations with Ask Atlas."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide usa tu micrófono para las conversaciones de voz con Ask Atlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchGuide utilise votre micro pour les conversations vocales avec Demander à Atlas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchGuide, Atlas से पूछें में वॉइस बातचीत के लिए आपके माइक्रोफ़ोन का इस्तेमाल करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchGuideは「Atlasに聞く」での音声会話にマイクを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchGuide는 Atlas에게 묻기의 음성 대화를 위해 마이크를 사용합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchGuide использует микрофон для голосовых разговоров в «Спросить Atlas»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchGuide 使用麦克风与“问 Atlas”进行语音对话。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Watch Guide التعرف على الكلام لتحويل طلباتك الصوتية إلى نص والتحكم في التطبيق دون استخدام اليدين."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Watch Guide uses speech recognition to transcribe your voice mode requests and control the app hands-free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide usa el reconocimiento de voz para transcribir tus peticiones en modo voz y controlar la app sin manos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide utilise la reconnaissance vocale pour transcrire vos demandes en mode vocal et contrôler l’app mains libres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide आपके वॉइस मोड अनुरोधों को लिखने और ऐप को हैंड्स-फ़्री चलाने के लिए स्पीच रिकग्निशन का इस्तेमाल करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guideは音声認識を使って音声モードのリクエストを文字に起こし、ハンズフリーでアプリを操作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide는 음성 인식을 사용해 음성 모드 요청을 받아쓰고 핸즈프리로 앱을 제어합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide использует распознавание речи, чтобы расшифровывать голосовые запросы и управлять приложением без рук."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch Guide 使用语音识别转写你的语音模式请求，实现免提操作应用。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
