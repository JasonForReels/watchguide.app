    "See what's releasing soon. Touch and hold, then Edit Widget to change the style." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطّلع على ما سيصدر قريبًا. المس مطولًا ثم اختر «تعديل الأداة» لتغيير النمط."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira lo que se estrena pronto. Mantén pulsado y elige Editar widget para cambiar el estilo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez les sorties à venir. Maintenez, puis Modifier le widget pour changer le style."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखें कि जल्द क्या रिलीज़ हो रहा है। स्टाइल बदलने के लिए दबाकर रखें, फिर विजेट संपादित करें चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まもなく公開の作品をチェック。長押しして「ウィジェットを編集」でスタイルを変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곧 공개될 작품을 확인하세요. 길게 누른 다음 위젯 편집에서 스타일을 바꿀 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите, что скоро выйдет. Нажмите и удерживайте, затем выберите «Изменить виджет», чтобы сменить стиль."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看即将上映的内容。按住小组件，然后选择“编辑小组件”以更改样式。"
          }
        }
      }
    },
    "Start a show in WatchGuide and your next episode shows up here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ مسلسلًا في WatchGuide وستظهر حلقتك التالية هنا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza una serie en WatchGuide y tu próximo episodio aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencez une série dans WatchGuide et votre prochain épisode apparaîtra ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchGuide में कोई शो शुरू करें और आपका अगला एपिसोड यहाँ दिखेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchGuideで番組を観はじめると、次のエピソードがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WatchGuide에서 프로그램을 보기 시작하면 다음 에피소드가 여기에 표시됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните сериал в WatchGuide, и следующая серия появится здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 WatchGuide 中开始看一部剧，下一集就会显示在这里。"
          }
        }
      }
    },
