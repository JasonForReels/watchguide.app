    "Open Atlas and ask about anything to watch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح Atlas واسأله عما تشاهد."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Atlas y pregúntale por cualquier cosa para ver."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Atlas et demandez-lui quoi regarder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atlas खोलें और देखने लायक कुछ भी पूछें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atlasを開いて、観たいものについて聞いてみよう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atlas를 열고 볼 만한 작품을 물어보세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Atlas и спросите, что посмотреть."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开 Atlas，问问看什么好。"
